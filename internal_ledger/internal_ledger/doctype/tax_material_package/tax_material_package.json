{
 "doctype": "DocType",
 "name": "Tax Material Package",
 "module": "Internal Ledger",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": ["company", "period", "package_type", "status", "version", "source_hash", "generated_by", "generated_at", "file", "totals_json", "disclaimer"],
 "fields": [
  {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
  {"fieldname": "period", "label": "Period", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "package_type", "label": "Package Type", "fieldtype": "Select", "options": "monthly_standard\nquarterly_standard\nannual_standard", "reqd": 1},
  {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Generating\nReady", "reqd": 1, "read_only": 1},
  {"fieldname": "version", "label": "Version", "fieldtype": "Int", "reqd": 1, "read_only": 1},
  {"fieldname": "source_hash", "label": "Source Hash", "fieldtype": "Data", "reqd": 1, "read_only": 1},
  {"fieldname": "generated_by", "label": "Generated By", "fieldtype": "Link", "options": "User", "reqd": 1, "read_only": 1},
  {"fieldname": "generated_at", "label": "Generated At", "fieldtype": "Datetime", "reqd": 1, "read_only": 1},
  {"fieldname": "file", "label": "Private Package", "fieldtype": "Attach", "read_only": 1},
  {"fieldname": "totals_json", "label": "Totals JSON", "fieldtype": "Long Text", "read_only": 1},
  {"fieldname": "disclaimer", "label": "Disclaimer", "fieldtype": "Small Text", "reqd": 1, "read_only": 1}
 ],
 "permissions": [
  {"role": "账套管理员", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "企业负责人", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "财务主管", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "会计", "read": 1, "create": 1, "report": 1},
  {"role": "出纳", "read": 1, "create": 1, "report": 1},
  {"role": "账务查看者", "read": 1, "report": 1},
  {"role": "只读审计", "read": 1, "report": 1}
 ]
}
