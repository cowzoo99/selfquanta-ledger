{
 "doctype": "DocType",
 "name": "Voucher Draft",
 "module": "Internal Ledger",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": ["imported_transaction", "company", "base_currency", "posting_date", "summary", "transaction_type", "status", "rejection_reason", "is_manual_override", "manual_override_by", "classification_rule", "classification_reason", "lines"],
 "fields": [
  {"fieldname": "imported_transaction", "label": "Imported Transaction", "fieldtype": "Link", "options": "Imported Transaction", "reqd": 1, "unique": 1},
  {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
  {"fieldname": "base_currency", "label": "Base Currency", "fieldtype": "Link", "options": "Currency", "reqd": 1},
  {"fieldname": "posting_date", "label": "Posting Date", "fieldtype": "Date", "reqd": 1},
  {"fieldname": "transaction_type", "label": "Transaction Type", "fieldtype": "Select", "options": "expense\nincome\ntransfer\nrefund\nfee", "reqd": 1},
  {"fieldname": "summary", "label": "Summary", "fieldtype": "Small Text"},
  {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nApproved\nRejected\nPosted", "default": "Draft", "reqd": 1, "read_only": 1},
  {"fieldname": "rejection_reason", "label": "Rejection Reason", "fieldtype": "Small Text", "read_only": 1},
  {"fieldname": "is_manual_override", "label": "Manual Override", "fieldtype": "Check", "default": "0", "read_only": 1},
  {"fieldname": "manual_override_by", "label": "Manual Override By", "fieldtype": "Link", "options": "User", "read_only": 1},
  {"fieldname": "classification_rule", "label": "Classification Rule", "fieldtype": "Link", "options": "Classification Rule", "reqd": 1},
  {"fieldname": "classification_reason", "label": "Classification Reason", "fieldtype": "Small Text", "reqd": 1},
  {"fieldname": "lines", "label": "Lines", "fieldtype": "Table", "options": "Voucher Draft Line", "reqd": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1},
  {"role": "账套管理员", "read": 1, "write": 1, "create": 1},
  {"role": "账务查看者", "read": 1}
 ]
}
