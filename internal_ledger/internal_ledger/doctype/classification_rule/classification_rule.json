{
 "doctype": "DocType",
 "name": "Classification Rule",
 "module": "Internal Ledger",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": ["company", "kind", "value", "direction", "transaction_type", "debit_account", "credit_account", "priority", "enabled", "confirmed"],
 "fields": [
  {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
  {"fieldname": "kind", "label": "Kind", "fieldtype": "Select", "options": "counterparty\nkeyword\nconfirmed_history", "reqd": 1},
  {"fieldname": "value", "label": "Value", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "direction", "label": "Direction", "fieldtype": "Select", "options": "income\nexpense", "default": "expense", "reqd": 1},
  {"fieldname": "transaction_type", "label": "Transaction Type", "fieldtype": "Select", "options": "expense\nincome\ntransfer\nrefund\nfee", "reqd": 1},
  {"fieldname": "debit_account", "label": "Debit Account", "fieldtype": "Link", "options": "Account"},
  {"fieldname": "credit_account", "label": "Credit Account", "fieldtype": "Link", "options": "Account"},
  {"fieldname": "priority", "label": "Priority", "fieldtype": "Int", "default": "0", "description": "Informational only; never resolves conflicts within a matching layer."},
  {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1"},
  {"fieldname": "confirmed", "label": "Confirmed History", "fieldtype": "Check", "default": "0"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1},
  {"role": "账套管理员", "read": 1, "write": 1, "create": 1},
  {"role": "账务查看者", "read": 1}
 ]
}
